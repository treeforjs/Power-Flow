        "import json\nimport numpy as np\nfrom mhdlab.solid_enthalpy import load_mills_2004_solid_enthalpy\nselection = dict(temperature_min_k=300., temperature_max_k=1700., reference_temperature_k=800., expected_material_family='austenitic stainless steel', expected_phase='solid', material_qualification='Evaluated source family; actual foil condition unknown', phase_qualification='Explicit solid branch; actual phase requires separate verification')\nreports=[]\nfor convention in ('printed_eq11', 'rezeroed_eq11'):\n    model=load_mills_2004_solid_enthalpy('data/materials/mills_2004_source_manifest.json', reference_convention=convention, **selection)\n    temperatures=np.array([[300., 700., np.nextafter(800., -np.inf)], [800., np.nextafter(800., np.inf), 1700.]])\n    values=model.evaluate(temperatures)\n    restored=model.temperature_from_enthalpy_k(values.enthalpy_j_kg)\n    rejected=[]\n    for h in (np.nextafter(model.supported_enthalpy_range_j_kg[0], -np.inf), np.nextafter(model.supported_enthalpy_range_j_kg[1], np.inf)):\n        try: model.temperature_from_enthalpy_k(h)\n        except ValueError: rejected.append(float(h))\n        else: raise AssertionError('Out-of-domain enthalpy accepted')\n    assert float(np.max(np.abs(temperatures-restored))) <= np.spacing(800.)\n    assert not values.enthalpy_j_kg.flags.writeable\n    reports.append(dict(reference_convention=convention, supported_enthalpy_range_j_kg=model.supported_enthalpy_range_j_kg, delta_enthalpy_j_kg=values.delta_enthalpy_from_reference_j_kg.tolist(), max_inverse_error_k=float(np.max(np.abs(temperatures-restored))), rejected_adjacent_external_enthalpies=rejected))\nprint(json.dumps(reports, indent=2))\n"
