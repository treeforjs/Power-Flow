#!/bin/sh
# SimQueue 0.7.2 node scheduler (zenobia: one pool, old partition names as aliases; event-driven worker,
# job memory tracked from the units' cgroups).  Same pinned interpreter as 0.5.
set -eu
unset SIMQUEUE_PCORES
export SIMQUEUE_PROJECT_ROOT=/home/treefor/projects
export SIMQUEUE_STATE_DIR=/home/treefor/.local/state/simqueue
export SIMQUEUE_CONFIG=/home/treefor/.local/state/simqueue/node.json
exec /home/treefor/projects/runtimes/simqueue-0.5.0-20261029/python-frozen /home/treefor/projects/runtimes/simqueue-0.7.2-20261105/source/simq "$@"
