+std::uint64_t json_u64(const ArenaJson &j) {
+  require(j.is_number_integer(), "exact nonnegative integer JSON required");
+  if (j.is_number_unsigned())
+    return j.get<std::uint64_t>();
+  auto n = j.get<std::int64_t>();
+  require(n >= 0, "negative integer JSON refused");
+  return static_cast<std::uint64_t>(n);
+}
+std::size_t json_size(const ArenaJson &j, std::size_t cap) {
+  auto n = json_u64(j);
+  require(n <= cap, "bounded JSON integer required");
+  return static_cast<std::size_t>(n);
+}
+double json_scalar(const ArenaJson &j) {
+  require(j.is_number(), "numeric JSON operand required");
+  double d = j.get<double>();
+  require(std::isfinite(d), "finite JSON operand required");
+  if (j.is_number_integer()) {
+    long double exact = j.is_number_unsigned()
+                            ? static_cast<long double>(j.get<std::uint64_t>())
+                            : static_cast<long double>(j.get<std::int64_t>());
+    require(exact == static_cast<long double>(d),
+            "integer JSON is not exactly representable as binary64");
+  }
+  return d;
+}
+bool json_boolean(const ArenaJson &j) {
+  require(j.is_boolean(), "boolean JSON operand required");
+  return j.get<bool>();
+}
+std::string json_text(const ArenaJson &j) {
+  require(j.is_string() && j.get_ref<const std::string &>().size() < 1024,
+          "bounded string JSON required");
+  return j.get<std::string>();
+}
+PicVector json_vector(const ArenaJson &j) {
+  require(j.is_array() && j.size() == 3,
+          "three-component JSON vector required");
+  return {json_scalar(j[0]), json_scalar(j[1]), json_scalar(j[2])};
+}
+std::set<std::string> json_id_set(const ArenaJson &j, std::size_t cap) {
+  require(j.is_array() && j.size() <= cap, "bounded identity array required");
+  std::set<std::string> r;
+  for (const auto &v : j)
+    require(r.insert(json_text(v)).second, "duplicate JSON identity");
+  return r;
+}
+ArenaJson read_full_json(const std::string &path) {
+  require(std::filesystem::file_size(path) <= 64 * 1024 * 1024,
+          "bounded full-time restart size");
+  std::ifstream input(path);
+  require(bool(input), "restart open failed");
+  std::size_t nodes = 0;
+  std::vector<std::optional<std::set<std::string>>> nesting;
+  auto callback = [&](int depth, ArenaJson::parse_event_t event,
+                      ArenaJson &parsed) {
+    require(depth <= 32 && ++nodes <= 8000000,
+            "bounded restart JSON depth/nodes");
+    if (event == ArenaJson::parse_event_t::object_start)
+      nesting.emplace_back(std::set<std::string>{});
+    else if (event == ArenaJson::parse_event_t::array_start)
+      nesting.emplace_back(std::nullopt);
+    else if (event == ArenaJson::parse_event_t::key) {
+      require(!nesting.empty() && bool(nesting.back()), "JSON key context");
+      require(nesting.back()->insert(json_text(parsed)).second,
+              "duplicate restart JSON key");
+    } else if (event == ArenaJson::parse_event_t::object_end ||
+               event == ArenaJson::parse_event_t::array_end) {
+      require(!nesting.empty(), "JSON nesting");
+      nesting.pop_back();
+    } else if (event == ArenaJson::parse_event_t::value) {
+      if (parsed.is_string())
+        (void)json_text(parsed);
+      if (parsed.is_number_float())
+        (void)json_scalar(parsed);
+    }
+    return true;
+  };
+  auto doc = ArenaJson::parse(input, callback);
+  input >> std::ws;
+  require(input.eof() && nesting.empty(), "trailing restart JSON data");
+  return doc;
+}
+// The frozen JSON destructor uses an allocating flattening stack. Empty bounded
+// trees bottom-up so snapshot retirement cannot allocate during publication.
+void drain_json(ArenaJson &j) noexcept {
+  if (j.is_object()) {
+    auto &object = j.get_ref<ArenaJson::object_t &>();
+    for (auto &item : object)
+      drain_json(item.second);
+    object.clear();
+  } else if (j.is_array()) {
+    auto &array = j.get_ref<ArenaJson::array_t &>();
+    for (auto &item : array)
+      drain_json(item);
+    array.clear();
+  }
+}
+void json_depth_guard(const ArenaJson &j, unsigned depth = 0) {
+  require(depth <= 32, "bounded metadata JSON depth");
+  if (j.is_object())
+    for (const auto &item : j.items())
+      json_depth_guard(item.value(), depth + 1);
+  else if (j.is_array())
+    for (const auto &item : j)
+      json_depth_guard(item, depth + 1);
+}
