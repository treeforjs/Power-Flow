+// Target-energy owner hook (API-008.txt 3.8; gas energy/momentum owner).
+// Recoil records: the admitted chemistry v3 C3 EventRec bytes as they are (384
+// bytes, pf_chem_v3 chem_event.h layout: u_in, ut, out species/destination/u,
+// q_eV, e_internal, internal_sink, W, process, candidate, carrier), with the
+// accepted step, stage and the native collision-grid cell (atlas ID, not the
+// stage's compact cell index); canonical order carrier ID, candidate. The owner
+// recomputes every SI term and checks the records root against the stage
+// receipt's records digest.
+struct FullTimeTargetRecoilRecord {
+  std::uint64_t accepted_step = 0, stage = 0;
+  std::uint32_t grid_cell = 0, reserved = 0;
+  std::array<unsigned char, 384> event{}; // pfc::EventRec bytes
+};
+// Target-species population changes the records do not show: for every debited
+// packet its carriers before (+1) and the remainder carriers after (-1), so a
+// partial debit stays exact; in stage 2 the released packets (-1: leaving the
+// reservoir into the carrier population).
+enum class FullTimeTargetFlowKind : std::uint8_t { debit_before = 1, debit_remainder = 2, release = 3 };
+struct FullTimeTargetFlowRecord {
+  FullTimeTargetFlowKind kind = FullTimeTargetFlowKind::debit_before;
+  std::int32_t sign = 1;          // +1 before, -1 after
+  std::uint32_t grid_cell = 0;    // atlas ID
+  std::string state;              // species state
+  double weight = 0;              // binary64 carrier weight
+  PicVector proper_velocity_m_s{};
+  double internal_energy_J = 0;   // carried internal energy (v8.1 metal vapour), else 0
+};
+// Interface of the gas energy/momentum owner. Call points (native v8.x, once
+// per chemistry stage): feedback() after the stage's CellTargets are built and
+// before the kernel (it may rewrite drift/s only in neutral target slots that
+// hold a deposit, and must leave the bytes untouched when its feedback is off,
+// so native's inputs digest binds the result); take() after the stage's
+// resolution and before publication (its digest is bound into the stage
