+// Audit schema v8.2: all published wall-response inputs are accepted state,
+// independent of whether their journal row has already been compacted.
+std::string published_sinks_digest(const FullTimeSinkLedger &l) {
+  Writer w;
+  w.tag("native-v8.2/published-sinks-v1");
+  w.text(sink_ledger_digest(l));
+  w.text(l.ledger_sha256);
+  w.text(l.row_sha256);
+  w.u64(l.records.size());
+  for (const auto &r : l.records) encode_sink_record(w, r);
+  w.u64(l.exposed.size());
+  for (const auto &e : l.exposed) {
+    encode_sink_record(w, e.record);
+    w.text(e.packet_id); w.text(e.state);
+    w.f64(e.weight); w.f64(e.charge_C); w.f64(e.mass_kg);
+    w.vec(e.start_position_m); w.f64(e.internal_energy_J);
+  }
   return cn::sha256_hex(w.bytes);
