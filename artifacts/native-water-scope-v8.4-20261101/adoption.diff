+        append_u64(data,row.native_id);append_u64(data,row.collision_cell);append_u64(data,row.species);
+        append_u64(data,std::bit_cast<std::uint64_t>(row.physical_count==0?0.0:row.physical_count));
+    }
+    return sha256(data);
+}
