+// The destination must already be owned by a drain guard. Build recursively in
+// place so failed allocation never destroys a partially copied JSON tree with
+// the vendored destructor's allocating flattening stack.
+void clone_json(ArenaJson &to, const ArenaJson &from) {
+  drain_json(to);
+  if (from.is_object()) {
+    to = ArenaJson::object();
+    for (const auto &[key, value] : from.items())
+      clone_json(to[key], value);
+  } else if (from.is_array()) {
+    to = ArenaJson::array();
+    for (const auto &value : from) {
+      to.push_back(nullptr);
+      clone_json(to.back(), value);
+    }
+  } else {
+    to = from;
+  }
+}
+struct GuardedArenaJson {
+  // Avoid null-to-object operator[] promotion: the vendored JSON sets its type
+  // before allocating storage, which is not unwind-safe under persistent OOM.
+  ArenaJson value = ArenaJson::object();
+  ~GuardedArenaJson() noexcept { drain_json(value); }
+  ArenaJson release() noexcept { return std::move(value); }
+};
