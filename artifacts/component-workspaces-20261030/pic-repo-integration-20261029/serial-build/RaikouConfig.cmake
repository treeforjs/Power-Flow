get_filename_component(PACKAGE_PREFIX_DIR "${CMAKE_CURRENT_LIST_DIR}/../../../" ABSOLUTE)

macro(set_and_check _var _file)
  set(${_var} "${_file}")
  if(NOT EXISTS "${_file}")
    message(FATAL_ERROR "File or directory ${_file} referenced by variable ${_var} does not exist !")
  endif()
endmacro()

macro(check_required_components _NAME)
  foreach(comp ${${_NAME}_FIND_COMPONENTS})
    if(NOT ${_NAME}_${comp}_FOUND)
      if(${_NAME}_FIND_REQUIRED_${comp})
        set(${_NAME}_FOUND FALSE)
      endif()
    endif()
  endforeach()
endmacro()

####################################################################################
set(Raikou_c_FOUND FALSE)
set(Raikou_native_FOUND FALSE)
set(Raikou_mfem_FOUND FALSE)
set(Raikou_ale_FOUND FALSE)
set(_raikou_components ${Raikou_FIND_COMPONENTS})
if(NOT _raikou_components)
  set(_raikou_components c native)
endif()
if("ale" IN_LIST _raikou_components AND OFF)
  list(PREPEND _raikou_components mfem)
  list(REMOVE_DUPLICATES _raikou_components)
endif()
if("mfem" IN_LIST _raikou_components AND ON)
  # Probe an optional component before loading its native SDK dependencies.
  # Required component failures are handled by check_required_components below.
  find_package(MFEM 4.10 QUIET CONFIG)
  if(MFEM_FOUND)
    list(PREPEND _raikou_components native)
    list(REMOVE_DUPLICATES _raikou_components)
  endif()
endif()
foreach(_raikou_component IN LISTS _raikou_components)
  if(_raikou_component STREQUAL "c")
    # The shared C ABI owns its native dependencies. A C-only consumer needs
    # headers and the import/shared library, without MPI/CUDA development tools.
    include("${CMAKE_CURRENT_LIST_DIR}/RaikouCTargets.cmake")
    set(Raikou_c_FOUND TRUE)
  elseif(_raikou_component STREQUAL "native")
    include(CMakeFindDependencyMacro)
    find_dependency(Threads)
    if(OFF)
      find_dependency(MPI COMPONENTS CXX)
    endif()
    if(OFF)
      find_dependency(CUDAToolkit)
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/RaikouNativeTargets.cmake")
    set(Raikou_native_FOUND TRUE)
  elseif(_raikou_component STREQUAL "mfem" AND ON)
    if(MFEM_FOUND)
      include("${CMAKE_CURRENT_LIST_DIR}/RaikouMFEMTargets.cmake")
      set(Raikou_mfem_FOUND TRUE)
    endif()
  elseif(_raikou_component STREQUAL "ale" AND OFF)
    if(Raikou_mfem_FOUND)
      include("${CMAKE_CURRENT_LIST_DIR}/RaikouALETargets.cmake")
      set(Raikou_ale_FOUND TRUE)
    endif()
  else()
    set(Raikou_${_raikou_component}_FOUND FALSE)
  endif()
endforeach()
unset(_raikou_component)
unset(_raikou_components)
check_required_components(Raikou)
