diff --git a/include/raikou/q1_scalar_gather.h b/include/raikou/q1_scalar_gather.h
new file mode 100644
index 0000000..d5caa74
--- /dev/null
+++ b/include/raikou/q1_scalar_gather.h
@@ -0,0 +1,92 @@
+#pragma once
+
+#include <mfem.hpp>
+#include <array>
+#include <vector>
+
+namespace raikou::mfem_backend {
+
+// Serial scalar Q1 gather with cached connectivity and stack scratch. Keep
+// MFEM's basis evaluation and physical Jacobian so evaluation order and mesh
+// geometry are unchanged. Other spaces, transformed DOFs, and updated spaces
+// use the ordinary GridFunction operations. Connectivity must stay unchanged
+// while cached: call invalidate() before unversioned DOF renumbering (for
+// example, FiniteElementSpace::ReorderElementToDofTable()).
+class Q1ScalarGather {
+public:
+    explicit Q1ScalarGather(const mfem::GridFunction& field)
+        : field_(field), space_(field.FESpace()),
+          mesh_sequence_(space_->GetMesh()->GetSequence()),
+          space_sequence_(space_->GetSequence()) {
+        const auto* mesh=space_->GetMesh();
+        if(space_->GetVDim()!=1 || mesh->Dimension()!=2 || mesh->SpaceDimension()!=2) return;
+        std::vector<std::array<int,4>> connectivity(mesh->GetNE());
+        mfem::Array<int> dofs;
+        mfem::DofTransformation transform;
+        for(int e=0;e<mesh->GetNE();++e) {
+            const auto* fe=space_->GetFE(e);
+            if(e==0) element_=fe;
+            else if(fe!=element_) return;
+            if(!dynamic_cast<const mfem::H1_QuadrilateralElement*>(fe) ||
+               fe->GetOrder()!=1 || fe->GetDof()!=4 ||
+               fe->GetMapType()!=mfem::FiniteElement::VALUE) return;
+            space_->GetElementDofs(e,dofs,transform);
+            if(dofs.Size()!=4 || !transform.IsIdentity()) return;
+            for(int j=0;j<4;++j) {
+                if(dofs[j]<0 || dofs[j]>=field_.Size()) return;
+                connectivity[e][j]=dofs[j];
+            }
+        }
+        dofs_=std::move(connectivity);
+    }
+
+    // Permanently fall back to MFEM. Construct a new gather to cache again.
+    void invalidate() { dofs_.clear(); }
+
+    bool available() const {
+        return !dofs_.empty() && field_.FESpace()==space_ &&
+            mesh_sequence_==space_->GetMesh()->GetSequence() &&
+            space_sequence_==space_->GetSequence();
+    }
+
+    double value(int element,const mfem::IntegrationPoint& point) const {
+        if(!available()) return field_.GetValue(element,point);
+        double shape_data[4],local_data[4];
+        mfem::Vector shape(shape_data,4),local(local_data,4);
+        load(element,local_data);
+        element_->CalcShape(point,shape);
+        return shape*local;
+    }
+
+    std::array<double,2> gradient(int element,const mfem::IntegrationPoint& point) const {
+        auto* transformation=field_.FESpace()->GetMesh()->GetElementTransformation(element);
+        transformation->SetIntPoint(&point);
+        if(!available()) {
+            mfem::Vector gradient;
+            field_.GetGradient(*transformation,gradient);
+            return {gradient[0],gradient[1]};
+        }
+        std::array<double,2> result{};
+        mfem::Vector gradient(result.data(),2);
+        double derivative_data[8],local_data[4],reference_data[2];
+        mfem::DenseMatrix derivatives(derivative_data,4,2);
+        mfem::Vector local(local_data,4),reference(reference_data,2);
+        load(element,local_data);
+        element_->CalcDShape(point,derivatives);
+        derivatives.MultTranspose(local,reference);
+        transformation->InverseJacobian().MultTranspose(reference,gradient);
+        return result;
+    }
+
+private:
+    void load(int element,double* local) const {
+        const double* values=field_.HostRead();
+        for(int j=0;j<4;++j) local[j]=values[dofs_[element][j]];
+    }
+    const mfem::GridFunction& field_;
+    const mfem::FiniteElementSpace* space_;
+    const mfem::FiniteElement* element_=nullptr;
+    long mesh_sequence_,space_sequence_;
+    std::vector<std::array<int,4>> dofs_;
+};
+} // namespace raikou::mfem_backend
diff --git a/tests/test_mfem_q1_scalar_gather.cpp b/tests/test_mfem_q1_scalar_gather.cpp
new file mode 100644
index 0000000..2a098e5
--- /dev/null
+++ b/tests/test_mfem_q1_scalar_gather.cpp
@@ -0,0 +1,99 @@
+#include "raikou/q1_scalar_gather.h"
+#include <cmath>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+
+using raikou::mfem_backend::Q1ScalarGather;
+namespace {
+void check(bool pass,const char* message) {
+    if(!pass) throw std::runtime_error(message);
+}
+void identical(double a,double b) {
+    check(std::memcmp(&a,&b,sizeof(a))==0,"Q1 gather changed the MFEM result bits");
+}
+void dof_renumbering_invalidation() {
+    auto mesh=mfem::Mesh::MakeCartesian2D(3,2,mfem::Element::QUADRILATERAL,true,2.,3.,false);
+    mfem::H1_FECollection collection(1,2);
+    mfem::FiniteElementSpace space(&mesh,&collection);
+    mfem::GridFunction field(&space);
+    for(int i=0;i<field.Size();++i) field[i]=i+1.;
+    Q1ScalarGather gather(field);
+    check(gather.available(),"Q1 gather initially cached");
+    const long mesh_sequence=mesh.GetSequence(),space_sequence=space.GetSequence();
+    // MFEM does not advance either sequence when it renumbers element DOFs.
+    gather.invalidate();
+    space.ReorderElementToDofTable();
+    check(mesh.GetSequence()==mesh_sequence && space.GetSequence()==space_sequence,
+          "DOF renumbering regression must exercise unchanged sequence counters");
+    check(!gather.available(),"explicit invalidation rejects renumbered connectivity");
+    gather.invalidate(); // Idempotent, including an already-disabled cache.
+    Q1ScalarGather rebuilt(field);
+    check(rebuilt.available(),"a new gather caches the renumbered connectivity");
+    for(int e=0;e<mesh.GetNE();++e) {
+        for(double x:{0.,.23,1.}) for(double y:{0.,.61,1.}) {
+            mfem::IntegrationPoint point;point.Set2(x,y);
+            const double value=field.GetValue(e,point);
+            identical(gather.value(e,point),value);
+            identical(rebuilt.value(e,point),value);
+            auto* transformation=mesh.GetElementTransformation(e);
+            transformation->SetIntPoint(&point);
+            mfem::Vector reference(2);field.GetGradient(*transformation,reference);
+            const auto fallback=gather.gradient(e,point),cached=rebuilt.gradient(e,point);
+            for(int i=0;i<2;++i) {
+                identical(fallback[i],reference[i]);identical(cached[i],reference[i]);
+            }
+        }
+    }
+}
+void compare(mfem::Mesh& mesh,int order,bool supported) {
+    mfem::H1_FECollection collection(order,2);
+    mfem::FiniteElementSpace space(&mesh,&collection);
+    mfem::GridFunction field(&space);
+    for(int i=0;i<field.Size();++i) field[i]=std::sin(17.*i)+i*.13;
+    Q1ScalarGather gather(field);
+    check(gather.available()==supported,"Q1 gather structural guard");
+    for(int e=0;e<mesh.GetNE();++e) {
+        for(double x:{0.,.001,.13,.5,.999,1.}) for(double y:{0.,.001,.37,.5,.999,1.}) {
+            mfem::IntegrationPoint point;point.Set2(x,y);
+            identical(gather.value(e,point),field.GetValue(e,point));
+            auto* transformation=mesh.GetElementTransformation(e);
+            transformation->SetIntPoint(&point);
+            mfem::Vector reference(2);field.GetGradient(*transformation,reference);
+            const auto actual=gather.gradient(e,point);
+            identical(actual[0],reference[0]);identical(actual[1],reference[1]);
+        }
+    }
+    // Connectivity becomes stale after a mesh/space update, so use MFEM again.
+    mesh.UniformRefinement();space.Update();field.Update();field=3.;
+    check(!gather.available(),"Q1 gather rejects stale connectivity");
+    mfem::IntegrationPoint point;point.Set2(.23,.61);
+    identical(gather.value(0,point),field.GetValue(0,point));
+    auto* transformation=mesh.GetElementTransformation(0);
+    transformation->SetIntPoint(&point);
+    mfem::Vector reference(2);field.GetGradient(*transformation,reference);
+    const auto actual=gather.gradient(0,point);
+    identical(actual[0],reference[0]);identical(actual[1],reference[1]);
+}
+}
+int main() {
+    try {
+        dof_renumbering_invalidation();
+        auto rectangles=mfem::Mesh::MakeCartesian2D(7,9,mfem::Element::QUADRILATERAL,true,.009,.013,false);
+        // Nonuniform rectangle spacing, with coordinates far from the origin.
+        for(int v=0;v<rectangles.GetNV();++v) {
+            auto* p=rectangles.GetVertex(v);p[0]=2.+p[0]*p[0]*100.;p[1]=-3.+p[1]*p[1]*80.;
+        }
+        compare(rectangles,1,true);
+        auto distorted=mfem::Mesh::MakeCartesian2D(3,4,mfem::Element::QUADRILATERAL,true,.009,.009,false);
+        for(int v=0;v<distorted.GetNV();++v) {
