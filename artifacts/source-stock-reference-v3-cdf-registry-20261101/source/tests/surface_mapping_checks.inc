  with_scope(f,[&](auto&a,auto&outer,auto&scope){SourceStep step(f,scope,true,true,true,upper?extracting:-extracting);const auto native_before=a.full_time_boundary()->accepted_arena_sha256;auto token=f.adapter->prepare(*f.source,step.trial,step.field,step.view(),scope,step.credit,step.neutral,step.electrons);auto trial=outer.fork_transport_trial(token.native_births());const auto&birth=step.trial.surface_births()[0];const auto&x=token.surface_transfers().at(0);const auto&b=token.credit().births[0];
   bool exact=token.electron_births()==1&&token.neutral_births()==3&&trial.census_v7().carriers.size()==4&&r::bits(b.position_m[2],birth.origin_m()[2])&&r::bits(x.field_origin,birth.origin_m())&&r::bits(x.native_origin[2],birth.origin_m()[2])&&r::bits(x.native_position[2],birth.origin_m()[2])&&x.bridge==(extracting>0)&&r::bits(x.wall_heat_J,birth.heat().source_wall_J)&&r::bits(x.electron_reference_J,birth.heat().source_electron_reference_change_J)&&r::bits(x.matching_work_J,birth.heat().source_field_work_J);
   for(std::size_t k=0;k<step.neutral.size();++k){const auto&p=step.trial.packets()[k];const auto it=std::find_if(token.credit().births.begin(),token.credit().births.end(),[&](const auto&y){return y.packet_id==step.neutral[k].native_packet_id;});exact=exact&&it!=token.credit().births.end()&&r::bits(it->position_m[2],center+p.x[2]);}
   const double plane=upper?f.options.upper_foil.bottom_m:f.options.lower_foil.top_m;exact=exact&&r::bits(x.native_origin[1],plane)&&((extracting==0&&b.position_m[1]==plane)||(extracting>0&&(upper?b.position_m[1]<plane:b.position_m[1]>plane)));
   t.check("typed local-neutral/global-electron mapping both electrodes and signed centers",exact,{{"upper",upper},{"center_m",center},{"F_extracting_V_m",extracting},{"native_z",b.position_m[2]},{"global_origin_z",birth.origin_m()[2]},{"neutral_global_z",token.credit().births.back().position_m[2]}});
   if(extracting==0){SourceStep legacy(f,scope,false,true,false,0.);auto bound=f.adapter->prepare(*f.source,legacy.trial,legacy.field,legacy.view(),scope,legacy.credit,legacy.neutral,legacy.electrons);const auto&original=legacy.trial.source_candidates()[0].state().surface_origin_m;auto doubled=legacy.credit;doubled.births[0].position_m[2]+=center;t.check("actual legacy Candidate/Handoff uses global origin without adding signed center twice",r::bits(bound.credit().births[0].position_m[2],original[2])&&r::bits(original[2],center+.0002));t.check("legacy v1 double-center coordinate preimage refuses in v2",refuses([&]{f.adapter->prepare(*f.source,legacy.trial,legacy.field,legacy.view(),scope,doubled,legacy.neutral,legacy.electrons);})&&f.source->state_sha256()==before);}
   if(extracting>0){const auto&br=token.native_births().receipt().bridges.at(0);const auto start=f.adapter->field_point(r::NativePoint{x.native_origin}).value,end=f.adapter->field_point(r::NativePoint{x.native_position}).value;r::V D{};for(int k=0;k<3;++k)D[k]=end[k]-start[k];
