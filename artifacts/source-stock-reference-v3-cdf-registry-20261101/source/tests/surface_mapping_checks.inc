   std::vector<hall_corrective_v3::Newborn>births;for(const auto&x:native.birth_flights())births.push_back({x.native_id,x.birth_time_s});bool collected=false,wrong=false;double elapsed=0,field_work=0,work_defect_gross=0,work_gross=0,Kinitial=m::pic_kinetic_energy_J(census[0].native),Kincident=0,hit_z=0;std::size_t steps=0;
   for(;steps<1000&&!collected;++steps){binding.accepted_step=steps;binding.trial_stage=steps+1;binding.begin_s=source.epoch.t+steps*binding.dt_s;binding.end_s=binding.begin_s+binding.dt_s;
    auto motion=hall_corrective_v3::MotionAssembly::cpu(context,census,binding,{},source.E,source.B,births,steps==0);field_work+=motion.budget().field_work_J;work_defect_gross+=std::abs(motion.budget().work_defect_J);work_gross+=std::abs(motion.budget().field_work_J);births.clear();
    if(!motion.sinks().empty()){const auto&sink=motion.sinks()[0];collected=motion.sinks().size()==1&&motion.endpoints().empty()&&sink.kind==1&&sink.conductor==(upper?1:0)&&sink.native_id==source.credit.births[0].native_id;Kincident=sink.weighted_kinetic_J;hit_z=sink.hit_point_m[2];elapsed=(steps*binding.dt_s)+sink.flight_s;wrong=wrong||sink.hit_point_m[1]!=(upper?f.options.upper_foil.bottom_m:f.options.lower_foil.top_m);}
