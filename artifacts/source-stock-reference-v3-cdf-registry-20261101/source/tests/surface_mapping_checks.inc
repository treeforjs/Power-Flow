   }
   const auto&emission=source.trial.surface_births()[0].phase().packet.particle.ledger;auto collection=se::collect_at_material_surface(f.config.work_function_eV,Kincident,1,true);
   const double energy_defect=emission.wall_heat_J+collection.wall_heat_J-field_work;const double scale=std::abs(emission.wall_heat_J)+std::abs(collection.wall_heat_J)+std::abs(field_work)+std::abs(Kinitial)+std::abs(Kincident);
