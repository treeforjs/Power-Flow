 for(bool upper:{true,false}){
  Fixture f(64,0x1p-50,upper?.004:-.004,upper);
  with_scope(f,[&](auto&,auto&outer,auto&scope){
   SourceStep source(f,scope,false,true,true,upper?-1e7:1e7);auto token=f.adapter->prepare(*f.source,source.trial,source.field,source.view(),scope,source.credit,source.neutral,source.electrons);auto native=outer.fork_transport_trial(token.native_births());auto census=native.native_census(1000);
