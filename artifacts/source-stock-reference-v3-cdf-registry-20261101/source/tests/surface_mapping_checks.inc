void native_first_hit_checks(Tests&t){
 {Fixture wrong;wrong.event_state="pfc-v3/H2O";with_scope(wrong,[&](auto&,auto&,auto&scope){SourceStep x(wrong,scope,false,true,true,3e9);t.check("electron source heat species must match actual native electron registry",refuses([&]{wrong.adapter->prepare(*wrong.source,x.trial,x.field,x.view(),scope,x.credit,x.neutral,x.electrons);}));});}

