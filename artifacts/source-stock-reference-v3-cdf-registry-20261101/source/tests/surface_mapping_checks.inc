    t.check("genuine native B3 bridge deposits once with compatible charge continuity and matching work",r::bits(br.field_start_m,start)&&r::bits(br.field_displacement_m,D)&&r::bits(br.charge_C,x.charge_C)&&continuity<=1e-12*std::abs(br.charge_C)&&std::abs(work-x.matching_work_J)<=bound,{{"source_work_J",x.matching_work_J},{"actual_bridge_work_J",work},{"work_bound_J",bound},{"continuity_C",continuity},{"scope","actual native birth bridge + compatible deposition; not accepted coupled Hall evolution"}});
    for(int fault=0;fault<7;++fault){auto c=step.credit;auto&z=c.births[0];if(fault==0)z.bridge=false;if(fault==1)z.bridge_start_m[2]+=center;if(fault==2)z.position_m[2]+=center;if(fault==3)z.bridge_start_m[1]=std::nextafter(z.bridge_start_m[1],INFINITY);if(fault==4)z.position_m[1]=std::nextafter(z.position_m[1],INFINITY);if(fault==5)z.returned=true;if(fault==6)z.origin+="other";t.check("surface B3 coordinate/token refusal "+std::to_string(fault),refuses([&]{f.adapter->prepare(*f.source,step.trial,step.field,step.view(),scope,c,step.neutral,step.electrons);})&&f.source->state_sha256()==before&&a.full_time_boundary()->accepted_arena_sha256==native_before);}
   }
